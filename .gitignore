# Локальный слой: выдуманные записи для проверки вёрстки, в прод не уезжают
*.local.json

# Пароль от задач: лежит рядом, но в репозиторий не уезжает никогда
.env

# Служебное от инструментов, в репозитории ему не место
.playwright-mcp/
__pycache__/
*.pyc

# playwright для tools/smoke.mjs: ставится разово, в репозиторий не уезжает
node_modules/
package*.json
